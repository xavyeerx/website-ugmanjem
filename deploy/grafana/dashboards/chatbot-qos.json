{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "title": "Total CPU Cores", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(count(node_cpu_seconds_total) by (cpu))", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "id": 1000 },

    { "title": "Total RAM (GB)", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [{ "expr": "node_memory_MemTotal_bytes", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "id": 1001 },

    { "title": "Available RAM", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "id": 1002 },

    { "title": "Total Storage (Root)", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [{ "expr": "node_filesystem_size_bytes{mountpoint=\"/\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "id": 1003 },

    { "title": "Available Storage", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [{ "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "id": 1004 },

    { "title": "Chat Requests / min", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(chatbot_chat_requests_total[1m]) * 60", "legendFormat": "{{ status }}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" } } },

    { "title": "End-to-End Latency (p50 / p95 / p99)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } } },

    { "title": "Error Rate (%)", "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [{
        "expr": "clamp_min(sum(increase(chatbot_chat_requests_total{status!=\"success\"}[$__range])) / clamp_min(sum(increase(chatbot_chat_requests_total[$__range])), 1) * 100, 0)",
        "legendFormat": "Error Rate", "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 2,
          "displayName": "Error Rate (%)",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true } },

    { "title": "Pipeline Latency Breakdown (Rata-rata per Tahap)",
      "description": "Dekomposisi latensi pipeline RAG per tahap: Retrieval (embedding+ChromaDB), Live Context (Supabase), Generation (GPT-4o-mini). Membantu mengidentifikasi bottleneck pipeline.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(chatbot_retrieval_duration_seconds_sum[5m]) / rate(chatbot_retrieval_duration_seconds_count[5m])", "legendFormat": "Retrieval — Embedding + ChromaDB", "refId": "A" },
        { "expr": "rate(chatbot_live_context_duration_seconds_sum[5m]) / rate(chatbot_live_context_duration_seconds_count[5m])", "legendFormat": "Live Context — Supabase", "refId": "B" },
        { "expr": "rate(chatbot_generation_duration_seconds_sum[5m]) / rate(chatbot_generation_duration_seconds_count[5m])", "legendFormat": "Generation — GPT-4o-mini", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } } },

    { "title": "In-Flight Requests", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "chatbot_http_requests_in_progress", "legendFormat": "{{ endpoint }}", "refId": "A" }] },

    { "title": "HTTP Request Rate by Status", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "rate(chatbot_http_requests_total[1m]) * 60", "legendFormat": "{{ method }} {{ endpoint }} {{ status }}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" } } },

    { "title": "Container CPU Usage (%)", "description": "CPU usage per Docker container saat load testing",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "docker_container_cpu_percent", "legendFormat": "{{ compose_service }}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } } },

    { "title": "Container Memory Usage (MB)", "description": "Memory usage per Docker container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "docker_container_memory_bytes / 1024 / 1024", "legendFormat": "{{ compose_service }}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } } },

    { "title": "Host CPU Usage (%)", "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "targets": [{ "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100", "legendFormat": "CPU %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":60},{"color":"red","value":85}] }
      }} },

    { "title": "Host Memory Usage (%)", "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}] }
      }} },

    { "title": "Host Disk Usage (%)", "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "targets": [{ "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "Disk %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}] }
      }} },

    { "title": "Avg Throughput (RPS)", "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 36 },
      "targets": [{ "expr": "sum(increase(chatbot_chat_requests_total[$__range])) / $__range_s", "legendFormat": "RPS", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "displayName": "Avg RPS" } } },

    { "title": "Total Requests (Cumulative)", "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 36 },
      "targets": [{ "expr": "sum(chatbot_chat_requests_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "displayName": "Total Requests" } } },

    { "title": "Uptime (Backend Container)", "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 36 },
      "targets": [{ "expr": "time() - process_start_time_seconds{job=\"chatbot-backend\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "displayName": "Uptime" } } },

    { "title": "Kepuasan Pengguna — Umpan Balik Rating Jawaban Chatbot",
      "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 2000 },

    { "title": "Distribusi Rating",
      "description": "Proporsi setiap kategori rating. Semakin besar area Sangat Membantu dan Membantu, semakin baik persepsi pengguna.",
      "type": "piechart", "id": 2010,
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 43 },
      "targets": [
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"very_helpful\"}[$__range]), 0)", "legendFormat": "Sangat Membantu", "refId": "A" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"helpful\"}[$__range]), 0)", "legendFormat": "Membantu", "refId": "B" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"not_helpful\"}[$__range]), 0)", "legendFormat": "Kurang Membantu", "refId": "C" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"very_not_helpful\"}[$__range]), 0)", "legendFormat": "Tidak Membantu", "refId": "D" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value","percent"] },
        "displayLabels": ["percent"]
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Sangat Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-green" } }] },
          { "matcher": { "id": "byName", "options": "Kurang Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "Tidak Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      } },

    { "title": "Tingkat Kepuasan (%)",
      "description": "Persentase penilaian positif (Membantu + Sangat Membantu) dari total rating.",
      "type": "stat", "id": 2011,
      "gridPos": { "h": 9, "w": 7, "x": 10, "y": 43 },
      "targets": [{
        "expr": "clamp_min(sum(increase(chatbot_rating_total{rating=~\"very_helpful|helpful\"}[$__range])), 0) / clamp_min(sum(increase(chatbot_rating_total[$__range])), 1) * 100",
        "legendFormat": "Positif (%)", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "displayName": "Rating Positif",
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":50},{"color":"green","value":75}] }
      }} },

    { "title": "Skor Rata-rata Kepuasan (1–4)",
      "description": "Skor tertimbang: (4×SangatMembantu + 3×Membantu + 2×KurangMembantu + 1×TidakMembantu) / Total.",
      "type": "gauge", "id": 2012,
      "gridPos": { "h": 9, "w": 7, "x": 17, "y": 43 },
      "targets": [{
        "expr": "(4 * clamp_min(increase(chatbot_rating_total{rating=\"very_helpful\"}[$__range]), 0) + 3 * clamp_min(increase(chatbot_rating_total{rating=\"helpful\"}[$__range]), 0) + 2 * clamp_min(increase(chatbot_rating_total{rating=\"not_helpful\"}[$__range]), 0) + 1 * clamp_min(increase(chatbot_rating_total{rating=\"very_not_helpful\"}[$__range]), 0)) / clamp_min(sum(increase(chatbot_rating_total[$__range])), 1)",
        "legendFormat": "Skor Rata-rata", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "none", "min": 1, "max": 4, "decimals": 2, "displayName": "dari 4.0",
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"orange","value":2},{"color":"yellow","value":2.5},{"color":"green","value":3}] }
      }} },

    { "title": "Tren Tingkat Kepuasan Seiring Waktu",
      "description": "Perubahan persentase rating positif dari waktu ke waktu.",
      "type": "timeseries", "id": 2013,
      "gridPos": { "h": 7, "w": 18, "x": 0, "y": 52 },
      "targets": [{
        "expr": "clamp_min(sum(rate(chatbot_rating_total{rating=~\"very_helpful|helpful\"}[$__rate_interval])), 0) / clamp_min(sum(rate(chatbot_rating_total[$__rate_interval])), 1e-9) * 100",
        "legendFormat": "Tingkat Kepuasan (%)", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "auto" },
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":50},{"color":"green","value":75}] }
      }} },

    { "title": "Total Rating Diterima", "type": "stat", "id": 2014,
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 52 },
      "targets": [{ "expr": "clamp_min(sum(increase(chatbot_rating_total[$__range])), 0)", "legendFormat": "penilaian", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "displayName": "Total Rating" } } }

  ],
  "schemaVersion": 39,
  "tags": ["chatbot", "rag", "qos", "ugm-anjem"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "UGM Anjem Chatbot - QoS Dashboard",
  "uid": "ugm-anjem-qos",
  "version": 1
}
