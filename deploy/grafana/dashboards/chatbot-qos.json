    {
      "title": "Tingkat Kepuasan",
      "description": "Persentase pengguna yang menilai jawaban chatbot positif. Formula: (Sangat Membantu + Membantu) / Total Rating x 100%. Threshold: hijau >= 75%, kuning >= 50%, merah < 50%.",
      "type": "stat",
      "id": 2011,
      "gridPos": {
        "h": 9,
        "w": 7,
        "x": 10,
        "y": 83
      },
      "targets": [
        {
          "expr": "clamp_min(sum(increase(chatbot_rating_total{rating=~\"very_helpful|helpful\"}[$__range])), 0) / clamp_min(sum(increase(chatbot_rating_total[$__range])), 1) * 100",
          "legendFormat": "Positif (Sangat Membantu + Membantu)",
          "refId": "A"
