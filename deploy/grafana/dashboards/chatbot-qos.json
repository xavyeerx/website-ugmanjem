      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "expr": "docker_container_network_rx_bytes",
          "legendFormat": "{{ compose_service }} RX",
          "refId": "A"
        },
        {
          "expr": "docker_container_network_tx_bytes",
          "legendFormat": "{{ compose_service }} TX",
