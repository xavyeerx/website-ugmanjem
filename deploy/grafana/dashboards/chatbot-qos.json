    {
      "title": "Avg Throughput (RPS)",
      "description": "Rata-rata throughput (requests per second) selama rentang waktu yang dipilih. Berguna untuk mencatat kapasitas layanan per skenario load test.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum(increase(chatbot_chat_requests_total[$__range])) / $__range_s",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "displayName": "Avg RPS"
        }
      }
    },
    {
      "title": "Reliability & Availability — Success Rate, Uptime, Error Tracking",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"padding:8px 0\"><h2 style=\"margin:0;color:#FF9830\">Reliability & Availability</h2><p style=\"margin:4px 0 0;color:#8e8e8e\">Success rate, uptime, error tracking, dan service availability</p></div>"
      }
    },
    {
      "title": "Chat Success Rate (Availability %)",
      "description": "Percentage of successful chat responses — key SLA metric",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 66
      },
      "targets": [
        {
          "expr": "clamp_max(sum(increase(chatbot_chat_requests_total{status=\"success\"}[$__range])) / clamp_min(sum(increase(chatbot_chat_requests_total[$__range])), 1) * 100, 100)",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "displayName": "Availability (range terpilih)",
          "description": "Persentase request chat yang berhasil (status=success) dari total request pada rentang waktu yang dipilih.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      }
    },
