{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "title": "Informasi Server", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100 },

    { "title": "Total CPU Cores", "type": "stat", "id": 101,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "count(count(node_cpu_seconds_total) by (cpu))", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },

    { "title": "Total RAM", "type": "stat", "id": 102,
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [{ "expr": "node_memory_MemTotal_bytes", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "title": "RAM Tersedia", "type": "stat", "id": 103,
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "title": "Total Storage (Root)", "type": "stat", "id": 104,
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [{ "expr": "node_filesystem_size_bytes{mountpoint=\"/\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "title": "Storage Tersedia", "type": "stat", "id": 105,
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [{ "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "title": "Ringkasan QoS & Reliabilitas", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 200 },

    { "title": "Total Chat Requests", "type": "stat", "id": 201,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(chatbot_chat_requests_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "displayName": "Total Requests" } } },

    { "title": "Avg Throughput (RPS)", "type": "stat", "id": 202,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "targets": [{ "expr": "sum(increase(chatbot_chat_requests_total[$__range])) / $__range_s", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 3, "displayName": "Avg RPS" } } },

    { "title": "Error Rate (%)", "type": "stat", "id": 203,
      "description": "Persentase request yang gagal dari total request selama periode monitoring.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "expr": "clamp_min(sum(increase(chatbot_chat_requests_total{status!=\"success\"}[$__range])) / clamp_min(sum(increase(chatbot_chat_requests_total[$__range])), 1) * 100, 0)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "displayName": "Error Rate",
        "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":5}] }
      } } },

    { "title": "Total Errors (Requests Gagal)", "type": "stat", "id": 204,
      "description": "Jumlah total request yang gagal selama periode monitoring.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "targets": [{ "expr": "clamp_min(sum(increase(chatbot_chat_requests_total{status!=\"success\"}[$__range])), 0)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "displayName": "Total Errors",
        "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] }
      } } },

    { "title": "Latensi & Throughput", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }, "id": 300 },

    { "title": "End-to-End Latency — p50 / p95 / p99", "type": "timeseries", "id": 301,
      "description": "Persentil latensi end-to-end dari request masuk sampai response diterima. p95/p99 menunjukkan pengalaman user di kondisi beban tinggi (worst-case).",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 11 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p50 (median)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } } },

    { "title": "Chat Throughput — Berhasil vs Gagal (req/menit)", "type": "timeseries", "id": 302,
      "description": "Jumlah request per menit yang berhasil diproses vs yang gagal. Menunjukkan kapasitas sistem saat beban naik.",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 11 },
      "targets": [
        { "expr": "rate(chatbot_chat_requests_total{status=\"success\"}[1m]) * 60", "legendFormat": "Berhasil", "refId": "A" },
        { "expr": "rate(chatbot_chat_requests_total{status!=\"success\"}[1m]) * 60", "legendFormat": "Gagal", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2 } } } },

    { "title": "Analisis Bottleneck Pipeline RAG", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "id": 400 },

    { "title": "Pipeline Latency Breakdown — Rata-rata per Tahap", "type": "timeseries", "id": 401,
      "description": "Dekomposisi latensi pipeline per tahap. Tahap dengan nilai tertinggi adalah bottleneck sistem. Retrieval = embed query + cari ChromaDB. Live Context = ambil data real-time Supabase. Generation = tunggu GPT-4o-mini.",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 21 },
      "targets": [
        { "expr": "rate(chatbot_retrieval_duration_seconds_sum[5m]) / rate(chatbot_retrieval_duration_seconds_count[5m])", "legendFormat": "Retrieval — Embedding + ChromaDB", "refId": "A" },
        { "expr": "rate(chatbot_live_context_duration_seconds_sum[5m]) / rate(chatbot_live_context_duration_seconds_count[5m])", "legendFormat": "Live Context — Supabase", "refId": "B" },
        { "expr": "rate(chatbot_generation_duration_seconds_sum[5m]) / rate(chatbot_generation_duration_seconds_count[5m])", "legendFormat": "Generation — GPT-4o-mini", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } } },

    { "title": "Concurrent Requests (In-Flight)", "type": "timeseries", "id": 402,
      "description": "Jumlah request yang sedang diproses bersamaan. Nilai tinggi = antrian panjang = latensi naik signifikan (queue time).",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 21 },
      "targets": [
        { "expr": "sum(chatbot_http_requests_in_progress)", "legendFormat": "Total In-Flight", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 20 } } } },

    { "title": "Error per Komponen Pipeline", "type": "timeseries", "id": 403,
      "description": "Error yang terjadi di masing-masing tahap pipeline. Membantu mendiagnosis penyebab kegagalan request.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 30 },
      "targets": [
        { "expr": "increase(chatbot_retrieval_errors_total[$__rate_interval])", "legendFormat": "Retrieval Errors", "refId": "A" },
        { "expr": "increase(chatbot_live_context_errors_total[$__rate_interval])", "legendFormat": "Live Context Errors", "refId": "B" },
        { "expr": "increase(chatbot_generation_errors_total[$__rate_interval])", "legendFormat": "Generation (OpenAI) Errors", "refId": "C" },
        { "expr": "increase(chatbot_generation_retries_total[$__rate_interval])", "legendFormat": "OpenAI API Retries", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } } },

    { "title": "Utilisasi Infrastruktur", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 }, "id": 600 },

    { "title": "CPU Usage (%)", "type": "gauge", "id": 601,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 38 },
      "targets": [{ "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100", "legendFormat": "CPU %", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":60},{"color":"red","value":85}] }
      } } },

    { "title": "Memory Usage (%)", "type": "gauge", "id": 602,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 38 },
      "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory %", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}] }
      } } },

    { "title": "Disk Usage (%)", "type": "gauge", "id": 603,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 38 },
      "targets": [{ "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "Disk %", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}] }
      } } },

    { "title": "Network I/O — Total Traffic (RX / TX)", "type": "stat", "id": 604,
      "description": "Total byte yang diterima (RX) dan dikirim (TX) server selama periode monitoring.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 38 },
      "targets": [
        { "expr": "sum(increase(node_network_receive_bytes_total{device!~\"lo\"}[$__range]))", "legendFormat": "Total RX", "refId": "A" },
        { "expr": "sum(increase(node_network_transmit_bytes_total{device!~\"lo\"}[$__range]))", "legendFormat": "Total TX", "refId": "B" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "title": "CPU Usage Trend (%)", "type": "timeseries", "id": 605,
      "description": "Tren penggunaan CPU host sepanjang periode load testing. Korelasikan dengan jumlah user aktif.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [{ "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))) * 100", "legendFormat": "CPU %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 15 } } } },

    { "title": "Memory Usage Trend (%)", "type": "timeseries", "id": 606,
      "description": "Tren penggunaan RAM host. Perhatikan apakah ada memory leak (terus naik tanpa turun).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 15 } } } },

    { "title": "Network I/O Trend (bytes/s)", "type": "timeseries", "id": 607,
      "description": "Laju transfer data jaringan per detik. RX = data masuk ke server, TX = data keluar dari server.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo\"}[1m]))", "legendFormat": "RX — Receive", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo\"}[1m]))", "legendFormat": "TX — Transmit", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } } } },

    { "title": "Kepuasan Pengguna — Umpan Balik Rating Jawaban Chatbot", "type": "row", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 }, "id": 700 },

    { "title": "Distribusi Rating", "type": "piechart", "id": 701,
      "description": "Proporsi setiap kategori rating. Semakin besar area Sangat Membantu dan Membantu, semakin baik persepsi pengguna.",
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 61 },
      "targets": [
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"very_helpful\"}[$__range]), 0)", "legendFormat": "Sangat Membantu", "refId": "A" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"helpful\"}[$__range]), 0)", "legendFormat": "Membantu", "refId": "B" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"not_helpful\"}[$__range]), 0)", "legendFormat": "Kurang Membantu", "refId": "C" },
        { "expr": "clamp_min(increase(chatbot_rating_total{rating=\"very_not_helpful\"}[$__range]), 0)", "legendFormat": "Tidak Membantu", "refId": "D" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value","percent"] },
        "displayLabels": ["percent"]
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Sangat Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-green" } }] },
          { "matcher": { "id": "byName", "options": "Kurang Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "Tidak Membantu" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      } },

    { "title": "Tingkat Kepuasan (%)", "type": "stat", "id": 702,
      "description": "Persentase penilaian positif (Membantu + Sangat Membantu) dari total rating yang diberikan.",
      "gridPos": { "h": 9, "w": 7, "x": 10, "y": 61 },
      "targets": [{
        "expr": "clamp_min(sum(increase(chatbot_rating_total{rating=~\"very_helpful|helpful\"}[$__range])), 0) / clamp_min(sum(increase(chatbot_rating_total[$__range])), 1) * 100",
        "legendFormat": "Positif (%)", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "displayName": "Rating Positif",
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":50},{"color":"green","value":75}] }
      } } },

    { "title": "Skor Rata-rata Kepuasan (1–4)", "type": "gauge", "id": 703,
      "description": "Skor tertimbang: (4×SangatMembantu + 3×Membantu + 2×KurangMembantu + 1×TidakMembantu) / Total rating.",
      "gridPos": { "h": 9, "w": 7, "x": 17, "y": 61 },
      "targets": [{
        "expr": "(4 * clamp_min(increase(chatbot_rating_total{rating=\"very_helpful\"}[$__range]), 0) + 3 * clamp_min(increase(chatbot_rating_total{rating=\"helpful\"}[$__range]), 0) + 2 * clamp_min(increase(chatbot_rating_total{rating=\"not_helpful\"}[$__range]), 0) + 1 * clamp_min(increase(chatbot_rating_total{rating=\"very_not_helpful\"}[$__range]), 0)) / clamp_min(sum(increase(chatbot_rating_total[$__range])), 1)",
        "legendFormat": "Skor Rata-rata", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "none", "min": 1, "max": 4, "decimals": 2, "displayName": "dari 4.0",
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"orange","value":2},{"color":"yellow","value":2.5},{"color":"green","value":3}] }
      } } },

    { "title": "Tren Tingkat Kepuasan Seiring Waktu", "type": "timeseries", "id": 704,
      "description": "Perubahan persentase rating positif dari waktu ke waktu.",
      "gridPos": { "h": 7, "w": 18, "x": 0, "y": 70 },
      "targets": [{
        "expr": "clamp_min(sum(rate(chatbot_rating_total{rating=~\"very_helpful|helpful\"}[$__rate_interval])), 0) / clamp_min(sum(rate(chatbot_rating_total[$__rate_interval])), 1e-9) * 100",
        "legendFormat": "Tingkat Kepuasan (%)", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "auto" },
        "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":50},{"color":"green","value":75}] }
      } } },

    { "title": "Total Rating Diterima", "type": "stat", "id": 705,
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 70 },
      "targets": [{ "expr": "clamp_min(sum(increase(chatbot_rating_total[$__range])), 0)", "legendFormat": "penilaian", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "displayName": "Total Rating" } } }

  ],
  "schemaVersion": 39,
  "tags": ["chatbot", "rag", "qos", "ugm-anjem"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "UGM Anjem Chatbot - QoS Dashboard",
  "uid": "ugm-anjem-qos",
  "version": 1
}
