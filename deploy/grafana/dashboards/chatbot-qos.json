    {
      "title": "Chat Requests / min",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(chatbot_chat_requests_total[1m]) * 60",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      }
    },
    {
      "title": "End-to-End Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(chatbot_chat_e2e_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Error Rate (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "expr": "clamp_min(sum(increase(chatbot_chat_requests_total{status!=\"success\"}[$__range])) / clamp_min(sum(increase(chatbot_chat_requests_total[$__range])), 1) * 100, 0)",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "displayName": "Error Rate (range terpilih)",
          "description": "Persentase request yang gagal dibanding total request pada rentang waktu yang dipilih. Formula: total_error / total_request x 100%.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "title": "Pipeline Latency Breakdown",
      "description": "Avg latency per RAG pipeline stage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(chatbot_retrieval_duration_seconds_sum[5m]) / rate(chatbot_retrieval_duration_seconds_count[5m])",
          "legendFormat": "Retrieval (ChromaDB)",
          "refId": "A"
        },
        {
          "expr": "rate(chatbot_live_context_duration_seconds_sum[5m]) / rate(chatbot_live_context_duration_seconds_count[5m])",
          "legendFormat": "Live Context (Supabase)",
          "refId": "B"
        },
        {
          "expr": "rate(chatbot_generation_duration_seconds_sum[5m]) / rate(chatbot_generation_duration_seconds_count[5m])",
          "legendFormat": "Generation (OpenAI GPT-4o mini)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Generation Latency Distribution",
      "type": "histogram",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(chatbot_generation_duration_seconds_bucket[5m])",
          "legendFormat": "{{ le }}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Retrieval Quality (Avg Distance)",
      "description": "Lower distance = more relevant retrieval. Track retrieval quality over time.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "chatbot_retrieval_distance_sum / chatbot_retrieval_distance_count",
          "legendFormat": "avg distance",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "title": "Live Context Cache Hit Rate (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(chatbot_live_context_cache_hits_total[5m]) / (rate(chatbot_live_context_cache_hits_total[5m]) + rate(chatbot_live_context_cache_misses_total[5m])) * 100",
          "legendFormat": "hit rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "OpenAI API Retries & Errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(chatbot_generation_retries_total[5m]) * 60",
          "legendFormat": "retries/min",
          "refId": "A"
        },
        {
          "expr": "rate(chatbot_generation_errors_total[5m]) * 60",
          "legendFormat": "errors/min ({{ error_type }})",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Avg Retrieval Chunks Returned",
      "description": "Rata-rata jumlah chunk dokumen yang diambil RAG per query. Nilai ideal sesuai konfigurasi top_k retriever. Nilai rendah menandakan knowledge base tidak menemukan konteks yang cukup relevan.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(chatbot_retrieval_chunks_returned_sum[5m]) / rate(chatbot_retrieval_chunks_returned_count[5m])",
          "legendFormat": "avg chunks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "title": "In-Flight Requests",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
